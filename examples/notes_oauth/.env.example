# GitHub OAuth App (browser login): Settings -> Developer settings -> OAuth Apps -> New
# Homepage URL:      http://localhost:8020
# Authorization URL: http://localhost:8020/auth/callback
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# Random string used to sign the session cookie (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-string

# The same GitHub app also protects the MCP endpoint via OAuth 2.1 (Claude
# Code browser login): the proxy's callback http://localhost:8020/auth/callback/mcp
# is a subdirectory of the registered callback above — no second app needed.
